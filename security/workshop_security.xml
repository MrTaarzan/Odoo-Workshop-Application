<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="groups_privilege_workshop" model="res.groups.privilege">
        <field name="name">Workshop</field>
        <field name="sequence">1</field>
        <field name="description">Helps in managing Workshop Jobs</field>
        <field name="category_id" ref="base.module_category_workshop"/>
    </record>

    <record id="group_workshop_receptionist" model="res.groups">
        <field name="name">Receptionist</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="groups_privilege_workshop"/>
        <field name="comment">The user will be able to create,view and manage job orders. Can create and update vehicles.</field>
    </record>

    <record id="group_workshop_mechanic" model="res.groups">
        <field name="name">Mechanic</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="groups_privilege_workshop"/>
        <field name="comment">The user will be able to view and update job orders assigned to them. Can view all vehicles and Bays</field>
    </record>

    <record id="group_workshop_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="groups_privilege_workshop"/>
        <field name="implied_ids" eval="[Command.link(ref('group_workshop_receptionist')),Command.link(ref('group_workshop_mechanic'))]"/>
        <field name="comment">Has full access to all workshop records, reporting and analytics. Access to all workshop management and configuration including accounting.</field>
    </record>

</odoo>