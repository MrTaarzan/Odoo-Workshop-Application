<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="workshop_vehicle_make_list_view" model="ir.ui.view">
        <field name="name">workshop.vehicle.make.list</field>
        <field name="model">workshop.vehicle.make</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="vehicle_make"/>
            </list>
        </field>
    </record>

    <record id="workshop_vehicle_make_search" model="ir.ui.view">
        <field name="name">workshop.vehicle.make.search</field>
        <field name="model">workshop.vehicle.make</field>
        <field name="arch" type="xml">
            <search>
                <filter string="Archived" name="inactive" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <record id="workshop_vehicle_make_action" model="ir.actions.act_window">
        <field name="name">Vehicle Make</field>
        <field name="res_model">workshop.vehicle.make</field>
        <field name="view_mode">list</field>
    </record>

</odoo>