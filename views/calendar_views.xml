<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_workshop_calendar_list_inherit" model="ir.ui.view">
        <field name="name">workshop.calendar.list.inherit</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='start']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='stop']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='duration']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_ids']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='alarm_ids']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='categ_ids']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='recurrency']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='location']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='privacy']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='name']" position="after">
                <field name="start_date" string="Date"/>
                <field name="customer_id"/>
                <field name="vehicle_id"/>
                <field name="customer_phone"/>
                <field name="appointment_confirm" string="Confirmed"/>
            </xpath>
        </field>
    </record>

    <record id="view_workshop_calendar_form_inherit" model="ir.ui.view">
        <field name="name">workshop.calendar.form.inherit</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//widget[@name='web_ribbon']" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_show_job_orders" type="object" class="oe_stat_button" icon="assignment" invisible="not job_order_ids" groups="workshop.group_workshop_receptionist">
                        <field string="Job Orders" name="job_order_count" widget="statinfo"/>
                    </button>
                </div>
            </xpath>

            <xpath expr="//field[@name='stop']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='stop_date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='location']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='videocall_location']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@class='w-100 py-2']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='res_record']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_open_composer']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='page_invitations']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='duration']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='allday']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//label[@for='allday']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//widget[@name='web_ribbon']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//button[@name='action_confirm']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='start_date']" position="attributes">
                <attribute name="string">Date</attribute>
            </xpath>

            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="placeholder">e.g. Too much smoke</attribute>
                <attribute name="string">Issues/ Service</attribute>
                <attribute name="tracking">True</attribute>
            </xpath>
            <xpath expr="//field[@name='notes']" position="attributes">
                <attribute name="placeholder">Add Customer notes.</attribute>
            </xpath>

            <xpath expr="//field[@name='start_date']" position="before">
                <field name="customer_id" readonly="appointment_confirm"/>
                <field name="customer_phone" readonly="appointment_confirm"/>
                <field name="vehicle_id" readonly="appointment_confirm"/>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_create_job_order" class="btn-primary" type="object" string="Create Job" invisible="not appointment_confirm"/>
                <button name="action_cancel_appointment" type="object" string="Cancel" invisible="not appointment_confirm"/>
                <button name="action_confirm_appointment" class="btn-primary" type="object" string="Confirm" invisible="appointment_confirm"/>
            </xpath>
        </field>
    </record>

    <record id="view_workshop_calendar_form_quick_create_inherit" model="ir.ui.view">
        <field name="name">workshop.calendar.form.quick.create</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form_quick_create"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='set_discuss_videocall_location']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='stop']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='duration']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='allday']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//label[@for='allday']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='location']" position="after">
                <field name="customer_id" placeholder="Customer"/>
                <field name="vehicle_id" placeholder="Vehicle"/>
            </xpath>
        </field>
    </record>

    <record id="view_workshop_calendar_select_inherit" model="ir.ui.view">
        <field name="name">workshop.calendar.select.inherit</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="customer_id"/>
                <field name="vehicle_id"/>
                <filter name="confirmed" string="Confirmed" domain="[('appointment_confirm','=',True)]"/>
                <group>
                    <filter string="Customer" name="customer" context="{'group_by':'customer_id'}"/>
                    <separator/>
                    <filter string="Vehicle" name="vehicle" context="{'group_by':'vehicle_id'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="workshop_calendar_action" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">calendar.event</field>
        <field name="view_mode">list,calendar,form,activity</field>
    </record>

</odoo>