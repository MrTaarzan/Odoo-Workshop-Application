<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="workshop_vehicle_list_view" model="ir.ui.view">
        <field name="name">workshop.vehicle.list</field>
        <field name="model">workshop.vehicle</field>
        <field name="arch" type="xml">
            <list>
                <field name="license_plate"/>
                <field name="vin_num"/>
                <field name="vehicle_make"/>
                <field name="vehicle_model"/>
                <field name="model_year"/>
                <field name="odometer_reading" optional="true"/>
                <field name="vehicle_owner_id" optional="true"/>
                <field name="vehicle_color" optional="true"/>
            </list>
        </field>
    </record>

    <record id="workshop_vehicle_form_view" model="ir.ui.view">
        <field name="name">workshop.vehicle.form</field>
        <field name="model">workshop.vehicle</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_job_history" type="object" class="oe_stat_button" icon="history" invisible="job_order_count=='0'">
                            <field string="Service History" name="job_order_count" widget="statinfo"/>
                        </button>
                    </div>
                    <h1><field name="license_plate" placeholder="Enter License Plate"/></h1><br/>
                    <group>
                        <group>
                            <field name="vin_num"/>
                            <field name="vehicle_make"/>
                            <field name="vehicle_model"/>
                            <field name="model_year"/>
                        </group>
                        <group>
                            <field name="odometer_reading"/>
                            <field name="vehicle_owner_id"/>
                            <field name="vehicle_color"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="workshop_vehicle_view_search" model="ir.ui.view">
        <field name="name">workshop.vehicle.search</field>
        <field name="model">workshop.vehicle</field>
        <field name="arch" type="xml">
            <search>
                <field name="license_plate"/>
                <field name="vin_num"/>
                <field name="vehicle_model"/>
                <field name="model_year"/>
                <field name="vehicle_color"/>
                <field name="vehicle_owner_id"/>
                <field name="odometer_reading" filter_domain="[('odometer_reading','>', self)]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active','=', False)]"/>
                <separator/>
                <group>
                    <filter string="Owner" name="vehicle_owner_id" context="{'group_by':'vehicle_owner_id'}"/>
                    <filter string="Manufacturer" name="vehicle_make" context="{'group_by':'vehicle_make'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="workshop_vehicle_action" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">workshop.vehicle</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>