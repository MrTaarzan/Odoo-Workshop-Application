<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="workshop_job_type_list_view" model="ir.ui.view">
        <field name="name">workshop.job.type.list</field>
        <field name="model">workshop.job.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="job_type_name"/>
            </list>
        </field>
    </record>

    <record id="workshop_job_type_search_view" model="ir.ui.view">
        <field name="name">workshop.job.type.search</field>
        <field name="model">workshop.job.type</field>
        <field name="arch" type="xml">
            <search>
                <filter string="Archived" name="active" domain="[('active','=','False')]"/>
            </search>
        </field>
    </record>

    <record id="workshop_job_type_action" model="ir.actions.act_window">
        <field name="name">Workshop Job Type</field>
        <field name="res_model">workshop.job.type</field>
        <field name="view_mode">list</field>
    </record>

</odoo>