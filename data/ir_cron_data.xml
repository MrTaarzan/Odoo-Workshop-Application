<?xml version="1.0"?>
<odoo>
    <data noupdate="1">
        <record forcecreate="True" id="ir_cron_workshop_pickup_reminder" model="ir.cron">
            <field name="name">Workshop: Pickup Reminder</field>
            <field name="model_id" ref="workshop.model_workshop_job_order"/>
            <field name="state">code</field>
            <field name="code">
model.send_pickup_reminder_mail()
            </field>
            <field name="active" eval="True"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

        <record forcecreate="True" id="ir_cron_workshop_appointment_reminder" model="ir.cron">
            <field name="name">Workshop: Appointment Reminder</field>
            <field name="model_id" ref="workshop.model_calendar_event"/>
            <field name="state">code</field>
            <field name="code">
model.send_appointment_reminder()
            </field>
            <field name="active" eval="True"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
    </data>
</odoo>